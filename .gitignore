!.gitignore

# ===== 本仓库实验工作流补充 =====

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Harbor / 判分 / run.py 运行产物（bench/jobs、bench/runs 同样命中）
jobs/
runs/
